APP_NAME=VOIC
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email verifikasi akun & lupa kata sandi.
# MAIL_MAILER=log  -> email tidak terkirim, link-nya ditulis ke storage/logs/laravel.log (untuk uji lokal).
# Agar email benar-benar terkirim (contoh Gmail, pakai "App Password", bukan kata sandi biasa):
#   MAIL_MAILER=smtp
#   MAIL_SCHEME=smtps
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=465
#   MAIL_USERNAME=akun.anda@gmail.com
#   MAIL_PASSWORD=app-password-16-huruf
#   MAIL_FROM_ADDRESS="akun.anda@gmail.com"
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@voic.app"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TIMEOUT=90

# VOIC booth: public URL for QR codes (LAN IP or tunnel) and data retention
VOIC_PUBLIC_URL=
VOIC_RETENTION_DAYS=7
VOIC_BOOTH_PIN=

# Otak AI penguji (Ollama). Kosong = model lokal "voic-coach" (100% offline).
# Contoh cloud: VOIC_AI_MODEL=kimi-k3:cloud (butuh internet + `ollama signin`; jika gagal, otomatis pakai model lokal).
VOIC_AI_MODEL=
# Data latih "guru-murid" (php artisan voic:teacher-generate): Kimi K3 sebagai penguji (guru),
# model lokal sebagai peserta simulasi.
VOIC_TEACHER_MODEL=kimi-k3:cloud
# Mode kecepatan. offline (default) = semua di laptop ini, privat, kecepatan tergantung hardware.
# online = untuk laptop tanpa GPU di booth yang ada internet: AI cloud cepat (GROQ_API_KEY) menjawab dulu dan
# browser mengenali suara, sehingga penguji membalas dalam 1-2 detik. AI lokal tetap jadi cadangan otomatis.
VOIC_SPEED_MODE=offline
VOIC_TEACHER_CANDIDATE_MODEL=qwen3:4b
OLLAMA_URL=http://127.0.0.1:11434
